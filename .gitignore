# Results and data (too large for git)
results/
data/models/*.pt

# Figure generation caches (derived, per-match binary files)
results_hr*/**/iqr_map.npy
results_hr*/**/ocr_readings_figure.pkl

# Goal clip compilation videos (too large for git)
results_hr*/goal_clips/*.mp4

# Pipeline run log (regenerated per run)
results_hr*/pipeline.log

# results_hr_10s/per_match/ shares intermediates with results_hr/per_match/
# via hardlinks for caching — only the 10s-specific outputs need to be
# committed (goal_highlights.csv, evaluation.json).  Everything else is a
# duplicate of results_hr/ and only exists locally.
results_hr_10s/per_match/**/player_counts.csv
results_hr_10s/per_match/**/shot_boundaries.csv
results_hr_10s/per_match/**/frame_classification.csv
results_hr_10s/per_match/**/score_events.csv
results_hr_10s/per_match/**/scoreboard_region.json
results_hr_10s/per_match/**/highlights.csv

